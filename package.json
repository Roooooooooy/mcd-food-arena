{
  "name": "mcd-food-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "node scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "mcp:probe": "node --env-file-if-exists=.env.local scripts/mcp-probe.ts",
    "demo:capture": "node scripts/capture-demo.ts",
    "dev:api": "node --env-file-if-exists=.env.local server/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
